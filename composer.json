{
    "name": "forwarder/belco-magento2",
    "license": "GPL-3.0",
    "type": "magento2-module",
    "version": "0.4.10",
    "description":"Belco.io Magento Module to install widget code and sync customer information.",
    "require": {
        "php": "~7.2.0|~7.3.0|~7.4.0|~8.0.0|~8.1.0|~8.2.0|~8.3.0|~8.4.0|~8.5.0",
        "magento/framework": "*"
    },
    "authors":[
        {
            "name":"Edwin",
            "email":"edwin@belco.io",
            "homepage": "https://www.belco.io"
        }
    ],
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Belco\\Widget\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
